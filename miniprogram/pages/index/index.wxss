/* 全局容器：灰色背景，内边距 */
.container {
  padding: 8px;
  background-color: #f5f6f8;
  min-height: 100vh;
  box-sizing: border-box;

}

/* --- 无网络连接页面样式 --- */
.no-network-page {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 3000;
}

.no-network-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40px;
}

.no-network-icon {
  width: 80px;
  height: 80px;
  border-radius: 50%;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24px;
}

.icon-text {
  font-size: 48px;
  font-weight: bold;
  color: #999;
}

.no-network-title {
  font-size: 18px;
  font-weight: bold;
  color: #333;
  margin-bottom: 12px;
}

.no-network-desc {
  font-size: 14px;
  color: #999;
  margin-bottom: 32px;
  text-align: center;
}

.no-network-btn {
  width: 160px;
  height: 44px;
  background: #07c160;
  color: #fff;
  font-size: 16px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  line-height: 44px;
}

.no-network-btn::after {
  border: none;
}

.no-network-btn-hover {
  opacity: 0.85;
  transform: scale(0.98);
}

.label {
  font-size: 12px;
  color: #888;
}

.value {
  font-size: 15px;
  font-weight: bold;
  color: #07c160;
  /* 微信绿 */
}

/* --- 通用卡片样式 --- */
.card {
  width: 100%;
  background: white;
  border-radius: 8px;
  /* 卡片圆角 */
  padding: 10px;
  /* 卡片内边距 */
  margin-bottom: 6px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
}

.card-header {
  display: flex;
  justify-content: space-between;
  /* 左右贴边 */
  align-items: flex-end;
  /* 靠下对齐 */
  border-bottom: 1px solid #eee;
  padding-bottom: 10px;
  margin-bottom: 10px;
}

.title {
  font-size: 16px;
  font-weight: bold;
  color: #333;
}

.card-header .device-name {
  font-size: 12px;
  font-weight: bold;
  color: #555;
}

.card-header .device-label {
  color: #487feb;
}

.card-header .value {
  font-size: 12px;
  font-weight: bold;
  color: #487eeb;
}

.card-header .value.status-disconnected {
  color: #555;
}

.subtitle {
  font-size: 12px;
  color: #999;
}

/* ----------------- 测量管理卡片布局 ---------------- */
/* --------- 测量状态行 --------- */
.measure-status-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
}

.measure-status-row .device-name {
  font-size: 13px;
  font-weight: bold;
  color: #555;
}

.measure-status-row .value {
  font-size: 13px;
  font-weight: bold;
  color: #487eeb;
}

/* 未连接和正在连接状态的灰黑色样式 */
.measure-status-row .value.status-disconnected {
  color: #555;
}

/* --------- 测量管理-第1行，连接设备、导出csv --------- */
.measure-admin-row1 {
  display: flex;
  /* 开启 Flex 布局 */
  flex-direction: row;
  /* 主轴方向为水平，子元素从左到右排列 */
  align-items: center;
  /* 交叉轴（垂直方向）居中对齐 */
  justify-content: space-between;
  /* 两端对齐，connect-device 靠左，btn-export 靠右 */
}

.connect-device {
  flex: 0 0 40%;
  background: #07c160;
  color: white;
  font-size: 13px;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 30px;
  margin: 0;
 
}

/* 已连接状态：红色字体 */
.connect-device.connected {
  background: #f5f5f5;
  color: #e53935;
  border: 1px solid #e53935;
}

.btn-reset {
  flex: 0 0 40%;
  background: #f0f0f0;
  color: #333;
  font-size: 13px;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 30px;
  margin: 0;
}

/*禁用归零时的样式表*/
.btn-reset.disabled {
  flex: 0 0 40%;
  background: #f5f5f5;
  color: #bbb;
  border: 1px solid #eee;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 30px;
  margin: 0;
}

.btn-export {
  flex: 0 0 40%;
  font-size: 13px;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 30px;
  background: #2f80ed;
  color: white;
  margin: 0;
}

/* -------- 测量管理-第2行，开始测量、归零 -------- */
.measure-admin-row2 {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.start_measure {
  flex: 0 0 40%;
  background: #07c160;
  color: white;
  font-size: 13px;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 30px;
  margin: 0;
}

/* 测量中状态：红色字体 */
.start_measure.measuring {
  background: #f5f5f5;
  color: #e53935;
  border: 1px solid #e53935;
}

/* -------- 测量管理-第3行，三个下拉选择框 -------- */
.measure-admin-row3 {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

.dropdown-picker {
  height: 30px;
  background: #f5f5f5;
  border-radius: 6px;
  border: 1px solid #e0e0e0;
}

/* 侧别选择器 - 较窄 */
.dropdown-picker:first-child {
  flex: 0 0 30%;
}

/* 部位选择器  */
.dropdown-picker:nth-child(2) {
  flex: 0 0 32%;
}

/* 动作选择器 - 中等宽度 */
.dropdown-picker:nth-child(3) {
  flex: 1;
}

.combined-picker {
  cursor: pointer;
  transition: all 0.2s ease;
}

.combined-picker:active {
  background: #e8e8e8;
  transform: scale(0.98);
}

.picker-content {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  height: 30px;
  padding: 0 10px;
}

.picker-label {
  font-size: 12px;
  color: #888;
  margin-right: 6px;
}

.picker-value {
  flex: 1;
  font-size: 13px;
  color: #333;
  font-weight: 500;
  text-align: center;
}

.picker-arrow {
  font-size: 10px;
  color: #999;
  margin-left: 4px;
}


.btn-start {
  background: #07c160;
  color: white;
}

/* --- 实时数据卡片 (RT-card) --- */
.RT-card {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 0px;

  /* 卡片之间的间距 */
}

.RT-data {
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  background: #fafafa;
  border-radius: 8px;
  /* 左右内边距15px，上下12px */
  padding: 4px 15px;

}

.RT-data .label {
  font-size: 13px;
  color: #888;
}

.RT-data .value {
  font-size: 20px;
  font-weight: bold;
}


/* --- MMT 卡片内容布局 --- */
.card-body {
  display: flex;
  flex-direction: row;
  min-height: 120px;
  align-items: stretch;
}

/* 左侧数据区 */
.left-panel {
  width: 100px;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  align-items: stretch;
  border-right: 1px solid #f0f0f0;
  padding: 0px 3px;
}

/* 峰值显示框 */
.peak-box {
  display: flex;
  flex-direction: column;
  padding: 5px;
  margin-bottom: 4.44px;
  background: #f8f9fa;
  border-radius: 6px;
  border: 1px solid #e9ecef;
}

.peak-label {
  font-size: 11px; 
  color: #888;
  align-self: flex-start;
  margin-bottom: 4px;
}

.peak-value {
  font-size: 16px; 
  font-weight: bold;
  color: #07c160;
  align-self: flex-end;
}

.metric-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 6.67px 0; 
  border-bottom: 0.5px solid #f9f9f9;
  min-height: 15px;
}

.metric-row .label {
  font-size: 11px;
  color: #888;
  flex-shrink: 0;
  white-space: nowrap;
}

.metric-row .value {
  font-size: 14px;
  font-weight: bold;
  color: #07c160;
  text-align: right;
}


/* 右侧图表区 */
.right-panel {
  flex: 1;
  margin-left: 10px;
  position: relative;
  display: flex;
  flex-direction: column;
  min-width: 120px;
}

.forceCanvas {
  width: 100%;
  height: 180px;
  display: block;
}

.chart-legend {
  position: absolute;
  top: 5px;
  right: 5px;
  display: flex;
  flex-direction: row;
  gap: 15px;
  z-index: 1;
  pointer-events: none;
}

.legend-item {
  display: flex;
  align-items: center;
}

.legend-label {
  font-size: 11px;
  color: #888;
  margin-right: 4px;
}

.legend-value {
  font-size: 14px;
  font-weight: bold;
  color: #07c160;
}


/*最近测量趋势卡片*/
.history-card .card-body {
  display: flex;
  flex-direction: row;
  height: 92px;
  align-items: center;
  overflow: hidden;
}

.history-left {
  width: 100px;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding-right: 10px;
  border-right: 1px solid #f0f0f0;
  height: 100%;
  gap: 8px;
}

/* 历史趋势小框样式 - 参考peak-box */
.history-box {
  display: flex;
  flex-direction: column;
  padding: 5px;
  background: #f8f9fa;
  border-radius: 6px;
  border: 1px solid #e9ecef;
}

.history-label {
  font-size: 11px;
  color: #888;
  align-self: flex-start;
  margin-bottom: 4px;
}

.history-value {
  font-size: 16px;
  font-weight: bold;
  color: #07c160;
  align-self: flex-end;
}

.history-value.up {
  color: #07c160;
}

.history-value.down {
  color: #eb5757;
}

.history-right {
  flex: 1;
  height: 100%;
  position: relative;
}

/* --- ROM 卡片内容布局 --- */
.rom-card {
  padding: 10px !important;
}

.title-group {
  display: flex;
  align-items: center;
  gap: 8px;
}

.rom-container {
  display: flex;
  height: 180px;
  margin-top: 10px;
}

.rom-panel {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 5px;
  position: relative;
}

.left-border {
  border-right: 1px solid #f0f0f0;
}

.rom-meta {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 5px;
}

.rom-main-val {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  width: 100%;
}

.rom-side-label {
  font-size: 14px;
  font-weight: bold;
  color: #333;
}

.big-angle {
  font-size: 22px;
  font-weight: bold;
  color: #2f80ed;
}

.rom-trend-mini {
  font-size: 14px;
  font-weight: bold;
}

.rom-trend-mini.up {
  color: #07c160;
}

.rom-trend-mini.down {
  color: #eb5757;
}

.rom-canvas {
  width: 100%;
  flex: 1;
  background: #fafafa;
}

.label-hint {
  font-size: 10px;
  color: #999;
}

/* --- 按钮点击效果 --- */
/* 绿色按钮按下效果 */
.btn-hover {
  opacity: 0.8;
  transform: scale(0.98);
  transition: all 0.1s ease;
}

/* 蓝色按钮按下效果 */
.btn-hover-blue {
  opacity: 0.8;
  transform: scale(0.98);
  transition: all 0.1s ease;
}

/* 灰色按钮按下效果 */
.btn-hover-gray {
  opacity: 0.8;
  transform: scale(0.98);
  transition: all 0.1s ease;
}

/* --- 自定义选择器弹窗样式 --- */
.picker-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
}

.picker-modal-container {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: white;
  border-radius: 16px 16px 0 0;
  z-index: 1001;
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.picker-modal-container.show {
  transform: translateY(0);
}

.picker-modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px 20px;
  border-bottom: 1px solid #f0f0f0;
}

.picker-modal-title {
  font-size: 16px;
  font-weight: bold;
  color: #333;
}

.picker-modal-cancel {
  font-size: 14px;
  color: #999;
}

.picker-modal-confirm {
  font-size: 14px;
  color: #07c160;
  font-weight: 500;
}

.picker-modal-body {
  height: 260px;
}

.picker-modal-item {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  color: #333;
}

/* --- 全屏按钮样式 --- */
.fullscreen-btn {
  position: absolute;
  right: 0px;
  bottom: 25px;
  width: 28px;
  height: 28px;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 4px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.15);
  z-index: 2;
}

.fullscreen-btn:active {
  background: rgba(240, 240, 240, 0.95);
  transform: scale(0.95);
}

.fullscreen-icon {
  font-size: 18px;
  color: #666;
}

/* ROM卡片全屏按钮特殊定位 */
.rom-fullscreen-btn {
  right: 5px;
  bottom: 5px;
}

/* 最近测试趋势全屏按钮特殊定位 */
.history-fullscreen-btn {
  right: 5px;
  bottom: 5px;
}

/* ROM趋势全屏按钮特殊定位 */
.rom-history-fullscreen-btn {
  right: 5px;
  bottom: 5px;
}

/* --- 全屏弹窗样式 --- */
.fullscreen-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  z-index: 2000;
  flex-direction: column;
  display: none;  
}

.fullscreen-modal.show {
  display: flex; 
}

.fullscreen-header {
  display: flex;
  align-items: center;
  padding: 12px 16px;
  background: #f8f8f8;
  border-bottom: 1px solid #eee;
  flex-shrink: 0;
}

.fullscreen-label {
  font-size: 14px;
  font-weight: bold;
  color: #07c160; 
  text-align: center;
  flex: 1;
}

.fullscreen-close {
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  color: #666;
  margin-left: 16px;
}

.fullscreen-close:active {
  background: #eee;
  border-radius: 50%;
}

.fullscreen-legend {
  display: flex;
  flex-direction: row;
  gap: 20px;
  flex: 1;
}

.fullscreen-canvas-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 10px;
  box-sizing: border-box;
}

.fullscreen-canvas {
  width: 100%;
  flex: 1;
  display: block;
}


/* 设备连接窗口 */
.device-list-header {
  padding: 15px;
  text-align: center;
  border-bottom: 1px solid #f5f5f5;
}
.list-title { font-size: 16px; font-weight: bold; display: block; }
.list-subtitle { font-size: 12px; color: #999; }

.device-list-scroll { height: 300px; }

.device-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15px 20px;
  border-bottom: 1px solid #f9f9f9;
}
.device-item:active { background: #f0f0f0; }

.device-item-left { display: flex; align-items: center; }
.device-icon {
  width: 36px; height: 36px; background: #e3f2fd; color: #2196f3;
  border-radius: 50%; display: flex; align-items: center; justify-content: center;
  font-size: 10px; font-weight: bold; margin-right: 12px;
}
.device-name-text { font-size: 14px; font-weight: 500; display: block; }
.device-mac { font-size: 11px; color: #bbb; }

.device-item-right { display: flex; align-items: center; }
.rssi-num { font-size: 12px; color: #888; margin-right: 10px; }

/* 信号格样式 */
.signal-icon { display: flex; align-items: flex-end; gap: 2px; height: 12px; }
.sig-bar { width: 3px; background: #ddd; border-radius: 1px; }
.sig-bar:nth-child(1) { height: 40%; }
.sig-bar:nth-child(2) { height: 60%; }
.sig-bar:nth-child(3) { height: 80%; }
.sig-bar:nth-child(4) { height: 100%; }
.sig-bar.active { background: #07c160; }